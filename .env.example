# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# beehiiv → Settings → Integrations → API → create a new key
BEEHIIV_API_KEY=

# beehiiv → Settings → Integrations → API (shown alongside the key),
# or the pub_... value in your beehiiv dashboard URL
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
